-    @Override public boolean onKeyDown(int keyCode, KeyEvent event) {
-        if (event.getRepeatCount() > 0 && keyCode == KeyEvent.KEYCODE_DPAD_CENTER) {
-            toggleCalibration();
-            return true;
-        }
-        switch (keyCode) {
-            case KeyEvent.KEYCODE_DPAD_CENTER:
-            case KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE:
-                if (player.isPlaying()) player.pause(); else player.play();
-                return true;
-            case KeyEvent.KEYCODE_DPAD_LEFT:
-                player.seekTo(Math.max(0L, player.getCurrentPosition() - 30_000L));
-                return true;
-            case KeyEvent.KEYCODE_DPAD_RIGHT:
-                player.seekTo(player.getCurrentPosition() + 30_000L);
-                return true;
-            case KeyEvent.KEYCODE_DPAD_DOWN:
-                int next = (calibration.getEffectMode() + 1) % 4;
-                calibration.setEffectMode(next);
-                renderer.setEffectMode(next);
-                setStatus("Effect: " + modeName(next));
-                return true;
-            case KeyEvent.KEYCODE_MENU:
-            case KeyEvent.KEYCODE_SETTINGS:
-                toggleCalibration();
-                return true;
-            case KeyEvent.KEYCODE_BACK:
-                if (calibrationVisible) {
-                    showCalibration(false);
-                    return true;
-                }
-                break;
-            default:
-                break;
-        }
-        return super.onKeyDown(keyCode, event);
-    }
