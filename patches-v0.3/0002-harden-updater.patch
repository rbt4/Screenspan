 import org.junit.Test;
 
 import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThrows;
 
 public final class ScreenSpanUpdaterTest {
+    private static final String HASH = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+
     @Test public void comparesSemanticVersions() {
         assertEquals(1, ScreenSpanUpdater.compareVersions("0.3.1", "0.3.0"));
         assertEquals(0, ScreenSpanUpdater.compareVersions("v1.2.0", "1.2"));
         assertEquals(-1, ScreenSpanUpdater.compareVersions("1.9.9", "2.0.0"));
     }
+
+    @Test public void acceptsMatchingChecksumFileName() {
+        assertEquals(HASH, ScreenSpanUpdater.checksumFor(
+                HASH + "  ScreenSpan-v0.3.0.apk\n", "ScreenSpan-v0.3.0.apk"));
+        assertEquals(HASH, ScreenSpanUpdater.checksumFor(
+                HASH + " */tmp/ScreenSpan-v0.3.0.apk\n", "ScreenSpan-v0.3.0.apk"));
+    }
+
+    @Test public void rejectsChecksumForDifferentFile() {
+        assertThrows(SecurityException.class, () -> ScreenSpanUpdater.checksumFor(
+                HASH + "  Other.apk\n", "ScreenSpan-v0.3.0.apk"));
+    }
+
+    @Test public void rejectsMalformedChecksum() {
+        assertThrows(SecurityException.class, () -> ScreenSpanUpdater.checksumFor(
+                "not-a-checksum", "ScreenSpan-v0.3.0.apk"));
+    }
